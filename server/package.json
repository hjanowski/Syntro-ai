{
  "name": "@syntro/server",
  "version": "0.1.0",
  "private": true,
  "description": "Syntro engine host for Node.js — HTTP API, event collector, Playwright execution workers, CLI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts demo",
    "typecheck": "tsc -p tsconfig.json",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@syntro/engine": "*",
    "express": "^4.21.1",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
